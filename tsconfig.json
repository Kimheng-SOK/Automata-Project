{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": false,
    "outDir": "./js",
    "sourceMap": false,
    "removeComments": false,
    "noImplicitAny": false,
    "strictNullChecks": true,
    "declarationMap": false
  },
  "include": ["ts_src/**/*.ts"],
  "exclude": ["node_modules", "**/*.spec.ts"]
}
